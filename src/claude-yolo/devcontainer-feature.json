{
    "name": "Claude YOLO",
    "id": "claude-yolo",
    "version": "1.0.2",
    "description": "Adds a 'claude-yolo' shell alias that runs 'claude --dangerously-skip-permissions'.",
    "documentationURL": "https://raw.githubusercontent.com/zjx20/devcontainer-features/main/src/claude-yolo/README.md",
    "customizations": {
        "vscode": {
            "settings": {
                "claudeCode.allowDangerouslySkipPermissions": true,
                "claudeCode.initialPermissionMode": "bypassPermissions"
            }
        }
    },
    "options": {}
}
